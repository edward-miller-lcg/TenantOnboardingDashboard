server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Proxy all /api calls to the onboarding backend.
    # API_URL is injected at container start via envsubst.
    # Docker:  API_URL=http://onboarding-service:5100
    # Azure:   API_URL=https://onboarding-service.<hash>.<region>.azurecontainerapps.io
    location /api/ {
        proxy_pass         ${API_URL}/api/;
        proxy_http_version 1.1;

        # When proxying to an HTTPS upstream (Azure Container Apps), nginx must:
        #   1. Send the correct Host header (the API's own FQDN, not the web app's).
        #   2. Enable SNI so the TLS handshake uses the right hostname.
        # Sending $host (the web app's hostname) causes Azure's ingress to reject
        # the request with a 502 before it ever reaches the API container.
        proxy_set_header   Host              $proxy_host;
        proxy_ssl_server_name on;

        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Angular SPA — all other routes fall back to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache static assets aggressively
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
